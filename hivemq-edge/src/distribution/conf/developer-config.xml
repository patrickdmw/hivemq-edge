<?xml version="1.0"?>
<hivemq xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="config.xsd">

    <mqtt-listeners>
        <tcp-listener>
            <port>1883</port>
            <bind-address>0.0.0.0</bind-address>
        </tcp-listener>
    </mqtt-listeners>

    <mqtt-bridges/>

    <admin-api>
        <enabled>true</enabled>
        <listeners>
            <http-listener>
                <port>8080</port>
                <bind-address>0.0.0.0</bind-address>
            </http-listener>
        </listeners>
        <generated-tokens>
            <keySize>2048</keySize>
            <issuer>HiveMQ-Edge</issuer>
            <audience>HiveMQ-Edge-Api</audience>
            <expiryTimeMinutes>30</expiryTimeMinutes>
            <tokenEarlyEpochThresholdMinutes>2</tokenEarlyEpochThresholdMinutes>
        </generated-tokens>
        <users>
            <user>
                <username>admin</username>
                <password>admin</password>
                <roles>
                    <role>admin</role>
                </roles>
            </user>
        </users>
        <pre-login-notice>
            <enabled>false</enabled>
        </pre-login-notice>
    </admin-api>

    <uns>
        <isa95>
            <enabled>false</enabled>
            <prefix-all-topics>false</prefix-all-topics>
        </isa95>
    </uns>

    <dynamic-configuration>
        <allow-configuration-export>false</allow-configuration-export>
        <allow-mutable-configuration>true</allow-mutable-configuration>
    </dynamic-configuration>

    <usage-tracking>
        <enabled>false</enabled>
    </usage-tracking>

    <protocol-adapters>
        <protocol-adapter>
            <adapterId>heller58507_he03</adapterId>
            <protocolId>s7</protocolId>
            <configVersion>1</configVersion>
            <config>
                <!-- from "PLCs-TWX-Lines-Stations-Devices-Tags.xlsx | Main" sheet -->
                <id>heller58507_he03</id>
                <host>192.168.122.1</host>
                <port>10102</port>
                <controllerType>S7_300</controllerType>
                <keepAlive>true</keepAlive>

                <!-- from "PLCs-TWX-Lines-Stations-Devices-Tags.xlsx | Main" sheet -->
                <remoteRack>0</remoteRack>
                <remoteRack2>0</remoteRack2>
                <remoteSlot>0</remoteSlot>
                <remoteSlot2>0</remoteSlot2>

                <!-- default 0 -->
                <remoteTsap>0</remoteTsap>

                <s7ToMqtt>
                    <!-- send mqtt message for every tag every poll interval, not just on changes -->
                    <!-- TODO change back after testing to reduce number of messages -->
                    <publishChangedDataOnly>false</publishChangedDataOnly>

                    <!-- poll every 10s -->
                    <pollingIntervalMillis>1000</pollingIntervalMillis>
                    <!-- mark connection as failed after 10 unsuccessful attempts -->
                    <maxPollingErrorsBeforeRemoval>10</maxPollingErrorsBeforeRemoval>
                </s7ToMqtt>
            </config>
            <tags>
